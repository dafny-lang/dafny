method {:test} Test0() {
var seqint0 : seq<int> := [38];
expect |seqint0| > 0, "If this check fails at runtime, the test does not meet the preconditions";
expect forall i :: 0 <= i < |seqint0| ==> seqint0[i] >= 0, "If this check fails at runtime, the test does not meet the preconditions";
var r0 := ConditionalGet(seqint0, 0);
expect 0 < 0 ==> r0 == -1;
expect 0 >= |seqint0| ==> r0 == -2;
expect 0 <= 0 < |seqint0| ==> r0 == seqint0[0];
}
