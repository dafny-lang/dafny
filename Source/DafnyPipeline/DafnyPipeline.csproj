<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>DafnyPipeline</AssemblyName>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>..\..\Binaries\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <RollForward>Major</RollForward>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0|AnyCPU'">
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!-- Working around some stange behavior in dotnet publish: https://github.com/dotnet/sdk/issues/10566 -->
  <PropertyGroup Condition="$(RUNTIME_IDENTIFIER) != ''">
    <RuntimeIdentifier>$(RUNTIME_IDENTIFIER)</RuntimeIdentifier>
  </PropertyGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\DafnyCore\DafnyCore.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <DafnyRuntimeJar>$(BaseIntermediateOutputPath)DafnyRuntime.jar</DafnyRuntimeJar>
    <DafnyRuntimeJavaArgFile>$(BaseIntermediateOutputPath)java-sources.txt</DafnyRuntimeJavaArgFile>
    <DafnyRuntimeJavaClasses>$(BaseIntermediateOutputPath)java-classes</DafnyRuntimeJavaClasses>
  </PropertyGroup>

  <!-- 
  Note that the CopyToOutputDirectory elements are important to ensure the runtime files
  appear in the zip file distribution created by package.py.
  If we manage to fully transition to a cleaner distribution as a `dotnet tool` instead,
  we may be able to get away with only embedding these files inside this assembly.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\DafnyStandardLibraries\binaries\DafnyStandardLibraries-notarget.doo">
      <LogicalName>DafnyStandardLibraries-notarget.doo</LogicalName>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyStandardLibraries\binaries\DafnyStandardLibraries-java.doo">
      <LogicalName>DafnyStandardLibraries-java.doo</LogicalName>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyStandardLibraries\binaries\DafnyStandardLibraries-cs.doo">
      <LogicalName>DafnyStandardLibraries-cs.doo</LogicalName>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyStandardLibraries\binaries\DafnyStandardLibraries-js.doo">
      <LogicalName>DafnyStandardLibraries-js.doo</LogicalName>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyStandardLibraries\binaries\DafnyStandardLibraries-go.doo">
      <LogicalName>DafnyStandardLibraries-go.doo</LogicalName>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyStandardLibraries\binaries\DafnyStandardLibraries-py.doo">
      <LogicalName>DafnyStandardLibraries-py.doo</LogicalName>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyStandardLibraries\src\Std\*Externs\**\*.cs">
      <LinkBase>DafnyStandardLibraries_cs</LinkBase>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyStandardLibraries\src\Std\*Externs\**\*.java">
      <LinkBase>DafnyStandardLibraries_java</LinkBase>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyStandardLibraries\src\Std\*Externs\**\*.js">
      <LinkBase>DafnyStandardLibraries_js</LinkBase>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyStandardLibraries\src\Std\*Externs\**\*.go">
      <LinkBase>DafnyStandardLibraries_go</LinkBase>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyStandardLibraries\src\Std\*Externs\**\*.py">
      <LinkBase>DafnyStandardLibraries_py</LinkBase>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>

    <EmbeddedResource Include="..\DafnyStandardLibraries\binaries\DafnyStandardLibraries.doo">
      <LogicalName>DafnyStandardLibraries.doo</LogicalName>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <DafnyRuntimeJavaSource Include="..\DafnyRuntime\DafnyRuntimeJava\src\main\java\**\*.java;..\DafnyRuntime\DafnyRuntimeJava\src\main\dafny-generated\**\*.java" />
    <EmbeddedResource Include="@(DafnyRuntimeJavaSource)">
      <LinkBase>DafnyRuntimeJava</LinkBase>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="$(DafnyRuntimeJar)">
      <LogicalName>DafnyRuntime.jar</LogicalName>
      <Link>DafnyRuntime.jar</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyRuntime\DafnyRuntime.cs">
      <LinkBase>DafnyRuntimeCsharp</LinkBase>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyRuntime\DafnyRuntimeSystemModule.cs">
      <LinkBase>DafnyRuntimeCsharp</LinkBase>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyRuntime\DafnyRuntimeGo\**\*.go" Exclude="..\DafnyRuntime\DafnyRuntimeGo\**\*_test.go">
      <LinkBase>DafnyRuntimeGo</LinkBase>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyRuntime\DafnyRuntimeCpp\**\*.h">
      <LinkBase>DafnyRuntimeCpp</LinkBase>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyRuntime\DafnyRuntimeCpp\**\*.cpp">
      <LinkBase>DafnyRuntimeCpp</LinkBase>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyRuntime\DafnyRuntimeJs\**\*.js">
      <LinkBase>DafnyRuntimeJs</LinkBase>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyRuntime\DafnyRuntimePython\**\*.py">
      <LinkBase>DafnyRuntimePython</LinkBase>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyRuntime\DafnyRuntimeRust\**" Exclude="..\DafnyRuntime\DafnyRuntimeRust\.gitignore" LinkBase="DafnyRuntimeRust">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Remove="..\DafnyRuntime\DafnyRuntimeRust\target\**"/>
  </ItemGroup>

  <Target Name="WriteDafnyRuntimeJavaSourceList">
    <!-- Rewritten only when the list changes, so adding or deleting a source rebuilds the jar.
         A javac argument file reads '\' as an escape, so spell the paths with '/'. -->
    <WriteLinesToFile File="$(DafnyRuntimeJavaArgFile)" Lines="@(DafnyRuntimeJavaSource->'&quot;%(Identity)&quot;'->Replace('\', '/'))" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="BuildDafnyRuntimeJar" BeforeTargets="PrepareResources" DependsOnTargets="WriteDafnyRuntimeJavaSourceList" Inputs="$(MSBuildProjectFile);$(DafnyRuntimeJavaArgFile);@(DafnyRuntimeJavaSource)" Outputs="$(DafnyRuntimeJar)">
    <PropertyGroup>
      <JavaBin Condition="'$(JAVA_HOME)' != ''">$(JAVA_HOME)/bin/</JavaBin>
    </PropertyGroup>
    <Exec Command="&quot;$(JavaBin)javac&quot; -version" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="JavacExitCode" />
      <Output TaskParameter="ConsoleOutput" PropertyName="JavacVersion" />
    </Exec>
    <Error Condition="'$(JavacExitCode)' != '0'" Text="Building Dafny's Java runtime needs a JDK 8 or later, but running $(JavaBin)javac failed. Set JAVA_HOME to a JDK, or put its bin directory on the PATH." />
    <PropertyGroup>
      <!-- javac 8 has no release flag; -source/-target is exact there, since it compiles against its own Java 8 library.
           javac 21 and later warn that targeting 8 is obsolete, which -Xlint:-options below silences. -->
      <JavaTarget Condition="$(JavacVersion.Contains('javac 1.'))">-source 8 -target 8</JavaTarget>
      <JavaTarget Condition="!$(JavacVersion.Contains('javac 1.'))">--release 8</JavaTarget>
    </PropertyGroup>
    <Message Text="Compiling the Java runtime to $(DafnyRuntimeJar) ($(JavacVersion), $(JavaTarget))" Importance="high" />
    <RemoveDir Directories="$(DafnyRuntimeJavaClasses)" />
    <!-- javac 8 fails on a missing output directory, where javac 9 and later create it. -->
    <MakeDir Directories="$(DafnyRuntimeJavaClasses)" />
    <Exec Command="&quot;$(JavaBin)javac&quot; $(JavaTarget) -encoding UTF-8 -g -proc:none -Xlint:unchecked,-options -d &quot;$(DafnyRuntimeJavaClasses)&quot; @&quot;$(DafnyRuntimeJavaArgFile)&quot;" />
    <Exec Command="&quot;$(JavaBin)jar&quot; cf &quot;$(DafnyRuntimeJar)&quot; -C &quot;$(DafnyRuntimeJavaClasses)&quot; ." />
  </Target>

  <Target Name="CleanDafnyRuntimeJar" AfterTargets="Clean">
    <Delete Files="$(DafnyRuntimeJar);$(DafnyRuntimeJavaArgFile)" />
    <RemoveDir Directories="$(DafnyRuntimeJavaClasses)" />
  </Target>

</Project>
